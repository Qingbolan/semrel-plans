// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/cars/Q10" {
  let n003 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/cars/Q10",
    node_id = "n003",
    operator_type = "SCAN",
    family = "input",
    label = "Scan cars",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n004 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/cars/Q10",
    node_id = "n004",
    operator_type = "SCAN",
    family = "input",
    label = "Scan complaints",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n002 = call "semrel.join" on "semrel-worker" with {
    query_id = "sembench/cars/Q10",
    node_id = "n002",
    operator_type = "JOIN",
    family = "relational",
    label = "⋈ car_id",
    plan_origin = "source_reconstruction",
    input_0 = n003.output,
    input_1 = n004.output
  } on_failure abort

  let n001 = call "semrel.sem_classify" on "semrel-worker" with {
    query_id = "sembench/cars/Q10",
    node_id = "n001",
    operator_type = "SEM_CLASSIFY",
    family = "semantic",
    label = "SEM_CLASSIFY 投诉→24个部件类别",
    plan_origin = "source_reconstruction",
    input_0 = n002.output
  } on_failure abort

  let n000 = call "semrel.project" on "semrel-worker" with {
    query_id = "sembench/cars/Q10",
    node_id = "n000",
    operator_type = "PROJECT",
    family = "relational",
    label = "π car_id, problem_category",
    plan_origin = "source_reconstruction",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
