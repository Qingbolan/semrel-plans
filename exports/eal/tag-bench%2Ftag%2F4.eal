// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "tag-bench/tag/4" {
  let n004 = call "semrel.scan" on "semrel-worker" with {
    query_id = "tag-bench/tag/4",
    node_id = "n004",
    operator_type = "SCAN",
    family = "input",
    label = "Scan schools",
    plan_origin = "baseline_reconstruction"
  } on_failure abort

  let n009 = call "semrel.scan" on "semrel-worker" with {
    query_id = "tag-bench/tag/4",
    node_id = "n009",
    operator_type = "SCAN",
    family = "input",
    label = "Scan schools",
    plan_origin = "baseline_reconstruction"
  } on_failure abort

  let n008 = call "semrel.project" on "semrel-worker" with {
    query_id = "tag-bench/tag/4",
    node_id = "n008",
    operator_type = "PROJECT",
    family = "relational",
    label = "π County",
    plan_origin = "baseline_reconstruction",
    input_0 = n009.output
  } on_failure abort

  let n007 = call "semrel.distinct" on "semrel-worker" with {
    query_id = "tag-bench/tag/4",
    node_id = "n007",
    operator_type = "DISTINCT",
    family = "relational",
    label = "δ DISTINCT",
    plan_origin = "baseline_reconstruction",
    input_0 = n008.output
  } on_failure abort

  let n006 = call "semrel.drop_null" on "semrel-worker" with {
    query_id = "tag-bench/tag/4",
    node_id = "n006",
    operator_type = "DROP_NULL",
    family = "relational",
    label = "DROP NULL",
    plan_origin = "baseline_reconstruction",
    input_0 = n007.output
  } on_failure abort

  let n005 = call "semrel.sem_filter" on "semrel-worker" with {
    query_id = "tag-bench/tag/4",
    node_id = "n005",
    operator_type = "SEM_FILTER",
    family = "semantic",
    label = "SEM_FILTER County 位于硅谷",
    plan_origin = "baseline_reconstruction",
    input_0 = n006.output
  } on_failure abort

  let n003 = call "semrel.semi_join" on "semrel-worker" with {
    query_id = "tag-bench/tag/4",
    node_id = "n003",
    operator_type = "SEMI_JOIN",
    family = "relational",
    label = "SEMI JOIN County",
    plan_origin = "baseline_reconstruction",
    input_0 = n004.output,
    input_1 = n005.output
  } on_failure abort

  let n002 = call "semrel.sort" on "semrel-worker" with {
    query_id = "tag-bench/tag/4",
    node_id = "n002",
    operator_type = "SORT",
    family = "relational",
    label = "τ Longitude DESC",
    plan_origin = "baseline_reconstruction",
    input_0 = n003.output
  } on_failure abort

  let n001 = call "semrel.limit" on "semrel-worker" with {
    query_id = "tag-bench/tag/4",
    node_id = "n001",
    operator_type = "LIMIT",
    family = "relational",
    label = "LIMIT 1",
    plan_origin = "baseline_reconstruction",
    input_0 = n002.output
  } on_failure abort

  let n000 = call "semrel.project" on "semrel-worker" with {
    query_id = "tag-bench/tag/4",
    node_id = "n000",
    operator_type = "PROJECT",
    family = "relational",
    label = "π GSoffered",
    plan_origin = "baseline_reconstruction",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
