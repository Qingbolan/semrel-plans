// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/cars/Q5" {
  let n007 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/cars/Q5",
    node_id = "n007",
    operator_type = "SCAN",
    family = "input",
    label = "Scan cars",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n006 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/cars/Q5",
    node_id = "n006",
    operator_type = "FILTER",
    family = "relational",
    label = "σ transmission = Automatic",
    plan_origin = "source_reconstruction",
    input_0 = n007.output
  } on_failure abort

  let n008 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/cars/Q5",
    node_id = "n008",
    operator_type = "SCAN",
    family = "input",
    label = "Scan audio_mm 录音",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n005 = call "semrel.join" on "semrel-worker" with {
    query_id = "sembench/cars/Q5",
    node_id = "n005",
    operator_type = "JOIN",
    family = "relational",
    label = "⋈ car_id",
    plan_origin = "source_reconstruction",
    input_0 = n006.output,
    input_1 = n008.output
  } on_failure abort

  let n009 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/cars/Q5",
    node_id = "n009",
    operator_type = "SCAN",
    family = "input",
    label = "Scan car_mm 图片",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n004 = call "semrel.join" on "semrel-worker" with {
    query_id = "sembench/cars/Q5",
    node_id = "n004",
    operator_type = "JOIN",
    family = "relational",
    label = "⋈ car_id",
    plan_origin = "source_reconstruction",
    input_0 = n005.output,
    input_1 = n009.output
  } on_failure abort

  let n003 = call "semrel.sem_filter" on "semrel-worker" with {
    query_id = "sembench/cars/Q5",
    node_id = "n003",
    operator_type = "SEM_FILTER",
    family = "semantic",
    label = "SEM_FILTER 图片损伤 AND 录音损伤",
    plan_origin = "source_reconstruction",
    input_0 = n004.output
  } on_failure abort

  let n002 = call "semrel.project" on "semrel-worker" with {
    query_id = "sembench/cars/Q5",
    node_id = "n002",
    operator_type = "PROJECT",
    family = "relational",
    label = "π car_id, transmission",
    plan_origin = "source_reconstruction",
    input_0 = n003.output
  } on_failure abort

  let n001 = call "semrel.distinct" on "semrel-worker" with {
    query_id = "sembench/cars/Q5",
    node_id = "n001",
    operator_type = "DISTINCT",
    family = "relational",
    label = "δ DISTINCT",
    plan_origin = "source_reconstruction",
    input_0 = n002.output
  } on_failure abort

  let n000 = call "semrel.aggregate" on "semrel-worker" with {
    query_id = "sembench/cars/Q5",
    node_id = "n000",
    operator_type = "AGGREGATE",
    family = "relational",
    label = "γ GROUP BY transmission; COUNT(*)",
    plan_origin = "source_reconstruction",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
