// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/mmqa/q4" {
  let n005 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/mmqa/q4",
    node_id = "n005",
    operator_type = "SCAN",
    family = "input",
    label = "Scan lizzy_caplan_text_data",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n004 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/mmqa/q4",
    node_id = "n004",
    operator_type = "FILTER",
    family = "relational",
    label = "σ title ∈ 原SQL的24部电影",
    plan_origin = "source_reconstruction",
    input_0 = n005.output
  } on_failure abort

  let n003 = call "semrel.sem_map" on "semrel-worker" with {
    query_id = "sembench/mmqa/q4",
    node_id = "n003",
    operator_type = "SEM_MAP",
    family = "semantic",
    label = "SEM_MAP 文本→全部genres[]",
    plan_origin = "source_reconstruction",
    input_0 = n004.output
  } on_failure abort

  let n002 = call "semrel.unnest" on "semrel-worker" with {
    query_id = "sembench/mmqa/q4",
    node_id = "n002",
    operator_type = "UNNEST",
    family = "relational",
    label = "UNNEST genres[]",
    plan_origin = "source_reconstruction",
    input_0 = n003.output
  } on_failure abort

  let n001 = call "semrel.aggregate" on "semrel-worker" with {
    query_id = "sembench/mmqa/q4",
    node_id = "n001",
    operator_type = "AGGREGATE",
    family = "relational",
    label = "γ GROUP BY genre; STRING_AGG(title)",
    plan_origin = "source_reconstruction",
    input_0 = n002.output
  } on_failure abort

  let n000 = call "semrel.sort" on "semrel-worker" with {
    query_id = "sembench/mmqa/q4",
    node_id = "n000",
    operator_type = "SORT",
    family = "relational",
    label = "τ genre ASC",
    plan_origin = "source_reconstruction",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
