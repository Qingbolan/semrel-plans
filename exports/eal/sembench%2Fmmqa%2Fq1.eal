// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/mmqa/q1" {
  let n003 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/mmqa/q1",
    node_id = "n003",
    operator_type = "SCAN",
    family = "input",
    label = "Scan ben_piazza",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n002 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/mmqa/q1",
    node_id = "n002",
    operator_type = "FILTER",
    family = "relational",
    label = "σ Role = Bob Whitewood",
    plan_origin = "source_reconstruction",
    input_0 = n003.output
  } on_failure abort

  let n005 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/mmqa/q1",
    node_id = "n005",
    operator_type = "SCAN",
    family = "input",
    label = "Scan ben_piazza_text_data",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n004 = call "semrel.sem_map" on "semrel-worker" with {
    query_id = "sembench/mmqa/q1",
    node_id = "n004",
    operator_type = "SEM_MAP",
    family = "semantic",
    label = "SEM_MAP 文本→导演名",
    plan_origin = "source_reconstruction",
    input_0 = n005.output
  } on_failure abort

  let n001 = call "semrel.join" on "semrel-worker" with {
    query_id = "sembench/mmqa/q1",
    node_id = "n001",
    operator_type = "JOIN",
    family = "relational",
    label = "⋈ Title = title",
    plan_origin = "source_reconstruction",
    input_0 = n002.output,
    input_1 = n004.output
  } on_failure abort

  let n000 = call "semrel.project" on "semrel-worker" with {
    query_id = "sembench/mmqa/q1",
    node_id = "n000",
    operator_type = "PROJECT",
    family = "relational",
    label = "π director",
    plan_origin = "source_reconstruction",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
