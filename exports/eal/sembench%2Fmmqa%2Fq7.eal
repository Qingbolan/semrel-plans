// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/mmqa/q7" {
  let n003 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/mmqa/q7",
    node_id = "n003",
    operator_type = "SCAN",
    family = "input",
    label = "Scan tampa_international_airport",
    plan_origin = "intent_sql_mismatch"
  } on_failure abort

  let n002 = call "semrel.sem_filter" on "semrel-worker" with {
    query_id = "sembench/mmqa/q7",
    node_id = "n002",
    operator_type = "SEM_FILTER",
    family = "semantic",
    label = "SEM_FILTER 有欧洲目的地",
    plan_origin = "intent_sql_mismatch",
    input_0 = n003.output
  } on_failure abort

  let n004 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/mmqa/q7",
    node_id = "n004",
    operator_type = "SCAN",
    family = "input",
    label = "Scan images",
    plan_origin = "intent_sql_mismatch"
  } on_failure abort

  let n001 = call "semrel.sem_join" on "semrel-worker" with {
    query_id = "sembench/mmqa/q7",
    node_id = "n001",
    operator_type = "SEM_JOIN",
    family = "semantic",
    label = "SEM_JOIN 图像是航空公司logo",
    plan_origin = "intent_sql_mismatch",
    input_0 = n002.output,
    input_1 = n004.output
  } on_failure abort

  let n000 = call "semrel.project" on "semrel-worker" with {
    query_id = "sembench/mmqa/q7",
    node_id = "n000",
    operator_type = "PROJECT",
    family = "relational",
    label = "π Airlines, uri",
    plan_origin = "intent_sql_mismatch",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
