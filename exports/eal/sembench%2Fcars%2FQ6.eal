  let n012 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/cars/Q6",
    node_id = "n012",
    operator_type = "FILTER",
    family = "relational",
    label = "σ 对应模态 ID 非空",
    plan_origin = "source_reconstruction",
    input_0 = n013.output
  } on_failure abort

  let n011 = call "semrel.sem_filter" on "semrel-worker" with {
    query_id = "sembench/cars/Q6",
    node_id = "n011",
    operator_type = "SEM_FILTER",
    family = "semantic",
    label = "SEM_FILTER 录音表明损伤",
    plan_origin = "source_reconstruction",
    input_0 = n012.output
  } on_failure abort

  let n010 = call "semrel.project" on "semrel-worker" with {
    query_id = "sembench/cars/Q6",
    node_id = "n010",
    operator_type = "PROJECT",
    family = "relational",
    label = "π car_id",
    plan_origin = "source_reconstruction",
    input_0 = n011.output
  } on_failure abort

  let n017 = call "semrel.cte_ref" on "semrel-worker" with {
