    node_id = "n005",
    operator_type = "LEFT_JOIN",
    family = "relational",
    label = "LEFT JOIN ×3 on car_id",
    plan_origin = "source_reconstruction",
    input_0 = n006.output,
    input_1 = n007.output,
    input_2 = n008.output,
    input_3 = n009.output
  } on_failure abort

  let n004 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/cars/Q6",
    node_id = "n004",
    operator_type = "FILTER",
    family = "relational",
    label = "σ 至少两种模态输入存在",
    plan_origin = "source_reconstruction",
    input_0 = n005.output
  } on_failure abort

  let n003 = call "semrel.cte" on "semrel-worker" with {
    query_id = "sembench/cars/Q6",
    node_id = "n003",
    operator_type = "CTE",
    family = "relational",
    label = "CTE two_more_modalities",
    plan_origin = "source_reconstruction",
    input_0 = n004.output
  } on_failure abort

  let n013 = call "semrel.cte_ref" on "semrel-worker" with {
    query_id = "sembench/cars/Q6",
    node_id = "n013",
    operator_type = "CTE_REF",
    family = "relational",
    label = "CTE REF two_more_modalities",
    plan_origin = "source_reconstruction"
