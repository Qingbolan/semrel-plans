// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/cars/Q6" {
  let n006 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/cars/Q6",
    node_id = "n006",
    operator_type = "SCAN",
    family = "input",
    label = "Scan cars",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n007 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/cars/Q6",
    node_id = "n007",
    operator_type = "SCAN",
    family = "input",
    label = "Scan car_mm 图片",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n008 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/cars/Q6",
    node_id = "n008",
    operator_type = "SCAN",
    family = "input",
    label = "Scan audio_mm 录音",
    plan_origin = "source_reconstruction"
