// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/ecomm/q8" {
  let n003 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/ecomm/q8",
    node_id = "n003",
    operator_type = "SCAN",
    family = "input",
    label = "Scan STYLES_DETAILS",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n002 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/ecomm/q8",
    node_id = "n002",
    operator_type = "FILTER",
    family = "relational",
    label = "σ description 长度 ≥ 3000",
    plan_origin = "source_reconstruction",
    input_0 = n003.output
  } on_failure abort

  let n004 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/ecomm/q8",
    node_id = "n004",
    operator_type = "SCAN",
    family = "input",
    label = "Scan IMAGES",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n001 = call "semrel.sem_join" on "semrel-worker" with {
    query_id = "sembench/ecomm/q8",
    node_id = "n001",
    operator_type = "SEM_JOIN",
    family = "semantic",
    label = "SEM_JOIN 图像符合描述",
    plan_origin = "source_reconstruction",
    input_0 = n002.output,
    input_1 = n004.output
  } on_failure abort

  let n000 = call "semrel.project" on "semrel-worker" with {
    query_id = "sembench/ecomm/q8",
    node_id = "n000",
    operator_type = "PROJECT",
    family = "relational",
    label = "π 源码拼接 imageID-imageID",
    plan_origin = "source_reconstruction",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
