// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/ecomm/q14" {
  let n005 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/ecomm/q14",
    node_id = "n005",
    operator_type = "SCAN",
    family = "input",
    label = "Scan STYLES_DETAILS",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n004 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/ecomm/q14",
    node_id = "n004",
    operator_type = "FILTER",
    family = "relational",
    label = "σ price<130",
    plan_origin = "source_reconstruction",
    input_0 = n005.output
  } on_failure abort

  let n006 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/ecomm/q14",
    node_id = "n006",
    operator_type = "SCAN",
    family = "input",
    label = "Scan IMAGES",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n003 = call "semrel.sem_join" on "semrel-worker" with {
    query_id = "sembench/ecomm/q14",
    node_id = "n003",
    operator_type = "SEM_JOIN",
    family = "semantic",
    label = "SEM_JOIN 图像符合描述",
    plan_origin = "source_reconstruction",
    input_0 = n004.output,
    input_1 = n006.output
  } on_failure abort

  let n002 = call "semrel.sem_filter" on "semrel-worker" with {
    query_id = "sembench/ecomm/q14",
    node_id = "n002",
    operator_type = "SEM_FILTER",
    family = "semantic",
    label = "SEM_FILTER 图像：白袜",
    plan_origin = "source_reconstruction",
    input_0 = n003.output
  } on_failure abort

  let n001 = call "semrel.sem_map" on "semrel-worker" with {
    query_id = "sembench/ecomm/q14",
    node_id = "n001",
    operator_type = "SEM_MAP",
    family = "semantic",
    label = "SEM_MAP score := 图像与描述匹配度",
    plan_origin = "source_reconstruction",
    input_0 = n002.output
  } on_failure abort

  let n000 = call "semrel.aggregate" on "semrel-worker" with {
    query_id = "sembench/ecomm/q14",
    node_id = "n000",
    operator_type = "AGGREGATE",
    family = "relational",
    label = "γ GROUP BY 商品id/标题/描述; ARRAY_AGG(imageID ORDER BY score ASC LIMIT 1)",
    plan_origin = "source_reconstruction",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
