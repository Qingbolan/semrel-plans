// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/mmqa/q5" {
  let n006 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/mmqa/q5",
    node_id = "n006",
    operator_type = "SCAN",
    family = "input",
    label = "Scan lizzy_caplan_text_data",
    plan_origin = "proposed_missing_sql"
  } on_failure abort

  let n005 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/mmqa/q5",
    node_id = "n005",
    operator_type = "FILTER",
    family = "relational",
    label = "σ title ∈ 指定16部电影",
    plan_origin = "proposed_missing_sql",
    input_0 = n006.output
  } on_failure abort

  let n004 = call "semrel.sem_map" on "semrel-worker" with {
    query_id = "sembench/mmqa/q5",
    node_id = "n004",
    operator_type = "SEM_MAP",
    family = "semantic",
    label = "SEM_MAP 文本→演员列表",
    plan_origin = "proposed_missing_sql",
    input_0 = n005.output
  } on_failure abort

  let n003 = call "semrel.unnest" on "semrel-worker" with {
    query_id = "sembench/mmqa/q5",
    node_id = "n003",
    operator_type = "UNNEST",
    family = "relational",
    label = "UNNEST actors[]",
    plan_origin = "proposed_missing_sql",
    input_0 = n004.output
  } on_failure abort

  let n002 = call "semrel.aggregate" on "semrel-worker" with {
    query_id = "sembench/mmqa/q5",
    node_id = "n002",
    operator_type = "AGGREGATE",
    family = "relational",
    label = "γ GROUP BY actor; COUNT(DISTINCT title)",
    plan_origin = "proposed_missing_sql",
    input_0 = n003.output
  } on_failure abort

  let n001 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/mmqa/q5",
    node_id = "n001",
    operator_type = "FILTER",
    family = "relational",
    label = "σ COUNT(DISTINCT title)=16",
    plan_origin = "proposed_missing_sql",
    input_0 = n002.output
  } on_failure abort

  let n000 = call "semrel.project" on "semrel-worker" with {
    query_id = "sembench/mmqa/q5",
    node_id = "n000",
    operator_type = "PROJECT",
    family = "relational",
    label = "π actor",
    plan_origin = "proposed_missing_sql",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
