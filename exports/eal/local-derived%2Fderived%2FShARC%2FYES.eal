// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "local-derived/derived/ShARC/YES" {
  let n003 = call "semrel.scan" on "semrel-worker" with {
    query_id = "local-derived/derived/ShARC/YES",
    node_id = "n003",
    operator_type = "SCAN",
    family = "input",
    label = "Scan 同规则个案",
    plan_origin = "derived_workload"
  } on_failure abort

  let n002 = call "semrel.sem_map" on "semrel-worker" with {
    query_id = "local-derived/derived/ShARC/YES",
    node_id = "n002",
    operator_type = "SEM_MAP",
    family = "semantic",
    label = "SEM_MAP scenario/history + 固定rule/question → 四态",
    plan_origin = "derived_workload",
    input_0 = n003.output
  } on_failure abort

  let n001 = call "semrel.filter" on "semrel-worker" with {
    query_id = "local-derived/derived/ShARC/YES",
    node_id = "n001",
    operator_type = "FILTER",
    family = "relational",
    label = "σ state=YES",
    plan_origin = "derived_workload",
    input_0 = n002.output
  } on_failure abort

  let n000 = call "semrel.project" on "semrel-worker" with {
    query_id = "local-derived/derived/ShARC/YES",
    node_id = "n000",
    operator_type = "PROJECT",
    family = "relational",
    label = "π case_id",
    plan_origin = "derived_workload",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
