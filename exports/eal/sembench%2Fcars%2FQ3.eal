// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/cars/Q3" {
  let n005 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/cars/Q3",
    node_id = "n005",
    operator_type = "SCAN",
    family = "input",
    label = "Scan cars",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n004 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/cars/Q3",
    node_id = "n004",
    operator_type = "FILTER",
    family = "relational",
    label = "σ transmission = Manual",
    plan_origin = "source_reconstruction",
    input_0 = n005.output
  } on_failure abort

  let n006 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/cars/Q3",
    node_id = "n006",
    operator_type = "SCAN",
    family = "input",
    label = "Scan car_mm 图片",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n003 = call "semrel.join" on "semrel-worker" with {
    query_id = "sembench/cars/Q3",
    node_id = "n003",
    operator_type = "JOIN",
    family = "relational",
    label = "⋈ car_id",
    plan_origin = "source_reconstruction",
    input_0 = n004.output,
    input_1 = n006.output
  } on_failure abort

  let n002 = call "semrel.sem_filter" on "semrel-worker" with {
    query_id = "sembench/cars/Q3",
    node_id = "n002",
    operator_type = "SEM_FILTER",
    family = "semantic",
    label = "SEM_FILTER 图片显示无损伤",
    plan_origin = "source_reconstruction",
    input_0 = n003.output
  } on_failure abort

  let n001 = call "semrel.project" on "semrel-worker" with {
    query_id = "sembench/cars/Q3",
    node_id = "n001",
    operator_type = "PROJECT",
    family = "relational",
    label = "π vin",
    plan_origin = "source_reconstruction",
    input_0 = n002.output
  } on_failure abort

  let n000 = call "semrel.limit" on "semrel-worker" with {
    query_id = "sembench/cars/Q3",
    node_id = "n000",
    operator_type = "LIMIT",
    family = "relational",
    label = "LIMIT 10",
    plan_origin = "source_reconstruction",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
