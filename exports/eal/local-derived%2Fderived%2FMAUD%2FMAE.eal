// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "local-derived/derived/MAUD/MAE" {
  let n002 = call "semrel.scan" on "semrel-worker" with {
    query_id = "local-derived/derived/MAUD/MAE",
    node_id = "n002",
    operator_type = "SCAN",
    family = "input",
    label = "Scan 给定deal-point文本",
    plan_origin = "derived_workload"
  } on_failure abort

  let n001 = call "semrel.sem_filter" on "semrel-worker" with {
    query_id = "local-derived/derived/MAUD/MAE",
    node_id = "n001",
    operator_type = "SEM_FILTER",
    family = "semantic",
    label = "SEM_FILTER 原问题选项包含 Ability to consummate transaction",
    plan_origin = "derived_workload",
    input_0 = n002.output
  } on_failure abort

  let n000 = call "semrel.project" on "semrel-worker" with {
    query_id = "local-derived/derived/MAUD/MAE",
    node_id = "n000",
    operator_type = "PROJECT",
    family = "relational",
    label = "π deal_id",
    plan_origin = "derived_workload",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
