// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "uda-bench/uda/Med/FilterJoin/2" {
  let n005 = call "semrel.scan" on "semrel-worker" with {
    query_id = "uda-bench/uda/Med/FilterJoin/2",
    node_id = "n005",
    operator_type = "SCAN",
    family = "input",
    label = "Scan disease 文档",
    plan_origin = "end_to_end_interpretation"
  } on_failure abort

  let n004 = call "semrel.sem_map" on "semrel-worker" with {
    query_id = "uda-bench/uda/Med/FilterJoin/2",
    node_id = "n004",
    operator_type = "SEM_MAP",
    family = "semantic",
    label = "SEM_MAP 疾病文档→属性",
    plan_origin = "end_to_end_interpretation",
    input_0 = n005.output
  } on_failure abort

  let n007 = call "semrel.scan" on "semrel-worker" with {
    query_id = "uda-bench/uda/Med/FilterJoin/2",
    node_id = "n007",
    operator_type = "SCAN",
    family = "input",
    label = "Scan institution 文档",
    plan_origin = "end_to_end_interpretation"
  } on_failure abort

  let n006 = call "semrel.sem_map" on "semrel-worker" with {
    query_id = "uda-bench/uda/Med/FilterJoin/2",
    node_id = "n006",
    operator_type = "SEM_MAP",
    family = "semantic",
    label = "SEM_MAP 机构文档→属性",
    plan_origin = "end_to_end_interpretation",
    input_0 = n007.output
  } on_failure abort

  let n003 = call "semrel.join" on "semrel-worker" with {
    query_id = "uda-bench/uda/Med/FilterJoin/2",
    node_id = "n003",
    operator_type = "JOIN",
    family = "relational",
    label = "⋈ disease.disease_name=institution.research_diseases",
    plan_origin = "end_to_end_interpretation",
    input_0 = n004.output,
    input_1 = n006.output
  } on_failure abort

  let n009 = call "semrel.scan" on "semrel-worker" with {
    query_id = "uda-bench/uda/Med/FilterJoin/2",
    node_id = "n009",
    operator_type = "SCAN",
    family = "input",
    label = "Scan drug 文档",
    plan_origin = "end_to_end_interpretation"
  } on_failure abort

  let n008 = call "semrel.sem_map" on "semrel-worker" with {
    query_id = "uda-bench/uda/Med/FilterJoin/2",
    node_id = "n008",
    operator_type = "SEM_MAP",
    family = "semantic",
    label = "SEM_MAP 药物文档→属性",
    plan_origin = "end_to_end_interpretation",
    input_0 = n009.output
  } on_failure abort

  let n002 = call "semrel.join" on "semrel-worker" with {
    query_id = "uda-bench/uda/Med/FilterJoin/2",
    node_id = "n002",
    operator_type = "JOIN",
    family = "relational",
    label = "⋈ disease_name",
    plan_origin = "end_to_end_interpretation",
    input_0 = n003.output,
    input_1 = n008.output
  } on_failure abort

  let n001 = call "semrel.filter" on "semrel-worker" with {
    query_id = "uda-bench/uda/Med/FilterJoin/2",
    node_id = "n001",
    operator_type = "FILTER",
    family = "relational",
    label = "σ pathogenesis='congenital'",
    plan_origin = "end_to_end_interpretation",
    input_0 = n002.output
  } on_failure abort

  let n000 = call "semrel.project" on "semrel-worker" with {
    query_id = "uda-bench/uda/Med/FilterJoin/2",
    node_id = "n000",
    operator_type = "PROJECT",
    family = "relational",
    label = "π key_achievements, manufacturer, funding_sources, disease_type",
    plan_origin = "end_to_end_interpretation",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
