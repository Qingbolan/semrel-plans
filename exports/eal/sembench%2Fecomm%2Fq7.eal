// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/ecomm/q7" {
  let n003 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/ecomm/q7",
    node_id = "n003",
    operator_type = "SCAN",
    family = "input",
    label = "Scan STYLES_DETAILS",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n002 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/ecomm/q7",
    node_id = "n002",
    operator_type = "FILTER",
    family = "relational",
    label = "σ price ≤ 500",
    plan_origin = "source_reconstruction",
    input_0 = n003.output
  } on_failure abort

  let n005 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/ecomm/q7",
    node_id = "n005",
    operator_type = "SCAN",
    family = "input",
    label = "Scan STYLES_DETAILS",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n004 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/ecomm/q7",
    node_id = "n004",
    operator_type = "FILTER",
    family = "relational",
    label = "σ price ≤ 500",
    plan_origin = "source_reconstruction",
    input_0 = n005.output
  } on_failure abort

  let n001 = call "semrel.sem_join" on "semrel-worker" with {
    query_id = "sembench/ecomm/q7",
    node_id = "n001",
    operator_type = "SEM_JOIN",
    family = "semantic",
    label = "SEM_JOIN 描述：同品牌 AND 同类别",
    plan_origin = "source_reconstruction",
    input_0 = n002.output,
    input_1 = n004.output
  } on_failure abort

  let n000 = call "semrel.project" on "semrel-worker" with {
    query_id = "sembench/ecomm/q7",
    node_id = "n000",
    operator_type = "PROJECT",
    family = "relational",
    label = "π p1.id-p2.id",
    plan_origin = "source_reconstruction",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
