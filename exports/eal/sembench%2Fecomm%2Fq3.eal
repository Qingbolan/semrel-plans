// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/ecomm/q3" {
  let n002 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/ecomm/q3",
    node_id = "n002",
    operator_type = "SCAN",
    family = "input",
    label = "Scan STYLES_DETAILS",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n001 = call "semrel.sem_map" on "semrel-worker" with {
    query_id = "sembench/ecomm/q3",
    node_id = "n001",
    operator_type = "SEM_MAP",
    family = "semantic",
    label = "SEM_MAP 描述→品牌",
    plan_origin = "source_reconstruction",
    input_0 = n002.output
  } on_failure abort

  let n000 = call "semrel.project" on "semrel-worker" with {
    query_id = "sembench/ecomm/q3",
    node_id = "n000",
    operator_type = "PROJECT",
    family = "relational",
    label = "π id, category=品牌",
    plan_origin = "source_reconstruction",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
