// Logical-plan representation; requires SemRel operator abilities.
// Labels are preserved, not parsed into executable predicates.
// input_0, input_1, ... preserve the source input positions.
mission "sembench/ecomm/q4" {
  let n005 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/ecomm/q4",
    node_id = "n005",
    operator_type = "SCAN",
    family = "input",
    label = "Scan STYLES_DETAILS",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n004 = call "semrel.filter" on "semrel-worker" with {
    query_id = "sembench/ecomm/q4",
    node_id = "n004",
    operator_type = "FILTER",
    family = "relational",
    label = "σ baseColour ∈ Black/Blue/Red/White/Orange/Green",
    plan_origin = "source_reconstruction",
    input_0 = n005.output
  } on_failure abort

  let n006 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/ecomm/q4",
    node_id = "n006",
    operator_type = "SCAN",
    family = "input",
    label = "Scan IMAGE_MAPPING",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n003 = call "semrel.join" on "semrel-worker" with {
    query_id = "sembench/ecomm/q4",
    node_id = "n003",
    operator_type = "JOIN",
    family = "relational",
    label = "⋈ imageURL = link",
    plan_origin = "source_reconstruction",
    input_0 = n004.output,
    input_1 = n006.output
  } on_failure abort

  let n007 = call "semrel.scan" on "semrel-worker" with {
    query_id = "sembench/ecomm/q4",
    node_id = "n007",
    operator_type = "SCAN",
    family = "input",
    label = "Scan IMAGES",
    plan_origin = "source_reconstruction"
  } on_failure abort

  let n002 = call "semrel.join" on "semrel-worker" with {
    query_id = "sembench/ecomm/q4",
    node_id = "n002",
    operator_type = "JOIN",
    family = "relational",
    label = "⋈ filename = basename(uri)",
    plan_origin = "source_reconstruction",
    input_0 = n003.output,
    input_1 = n007.output
  } on_failure abort

  let n001 = call "semrel.sem_map" on "semrel-worker" with {
    query_id = "sembench/ecomm/q4",
    node_id = "n001",
    operator_type = "SEM_MAP",
    family = "semantic",
    label = "SEM_MAP 图像→主色",
    plan_origin = "source_reconstruction",
    input_0 = n002.output
  } on_failure abort

  let n000 = call "semrel.project" on "semrel-worker" with {
    query_id = "sembench/ecomm/q4",
    node_id = "n000",
    operator_type = "PROJECT",
    family = "relational",
    label = "π id, category=主色",
    plan_origin = "source_reconstruction",
    input_0 = n001.output
  } on_failure abort

  emit "result" kind answer value n000.output
}
