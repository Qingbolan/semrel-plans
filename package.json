{
  "name": "semrel-atlas",
  "private": true,
  "scripts": {
    "build:viewer": "esbuild src/viewer/graph/index.jsx --bundle --minify --format=iife --global-name=SemRelGraph --outfile=assets/graph.js",
    "test:viewer": "node --test tests/graph-layout.test.mjs && node tests/test_reader_state.js && node tests/test_eal_highlight.cjs && node tests/test_content_locale.cjs",
    "build": "npm run build:viewer && npm run build:papers && python3 scripts/build.py",
    "build:papers": "esbuild src/viewer/papers.js --bundle --minify --format=iife --global-name=SemRelPapers --outfile=assets/paper-view.js"
  },
  "dependencies": {
    "@lexical/code": "^0.49.0",
    "@lexical/html": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/table": "^0.49.0",
    "@xyflow/react": "^12.12.0",
    "dompurify": "^3.4.16",
    "elkjs": "^0.12.0",
    "lexical": "^0.49.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
